<%- include('partials/workspace-start', {title: 'Add nurse'}) %><header class="page-head"><h1>Add nurse</h1><a href="/admin/nurses">Back to nurses</a></header><% if(error) { %><p class="error" role="alert"><%= error %></p><% } %><form class="card form-grid" method="post" action="/admin/add/nurse"><label>Full name<input name="name" required></label><label>Email<input name="email" type="email" required></label><label class="wide">Phone (optional)<input name="phoneNumber" type="tel"></label><label>Password<input type="password" name="password" minlength="8" autocomplete="new-password" required></label><label>Confirm password<input type="password" name="confirmPassword" minlength="8" autocomplete="new-password" required></label><div class="wide"><button>Add nurse</button></div></form><%- include('partials/workspace-end') %>
