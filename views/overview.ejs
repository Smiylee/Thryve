<%- include('partials/workspace-start', {title: 'Health overview'}) %>
<div class="eyebrow">Overview</div><header class="page-head"><div><h1>Overview</h1><p class="subtitle">Student records, recent visits, and shift status.</p></div><a class="button" href="/student/records">View student records ↗</a></header>
<div class="actions quick-links"><a class="button" href="/add/student">+ Add student</a><a class="button secondary" href="/student/records">Record a visit</a><a class="button secondary" href="<%= isAdmin ? '/admin/shifts' : '/nurse/shifts' %>"><%= isAdmin ? 'Review shifts' : 'Manage my shift' %></a><a class="button secondary" href="<%= isAdmin ? '/admin/analytics' : '/nurse/analytics' %>">Explore analytics →</a></div>
<section class="card attention"><h2>Open cases <span class="badge"><%= openCases.length %></span></h2><p class="muted small">Unresolved visits.</p><% openCases.slice(0,5).forEach(c=>{ %><div class="bar-label"><a href="/student/view/<%= c.studentId %>#visit-<%= c.id %>"><%= c.student.name %> · <%= c.complaintIdent %></a><span class="badge <%= c.severity %>"><%= c.severity %></span></div><% }) %><% if(!openCases.length){ %><p class="muted">No outstanding cases.</p><% } %></section>
<form class="actions" method="get"><label for="days">Reporting period</label><select class="filter" name="days" id="days"><% [7,30,90].forEach(d => { %><option value="<%= d %>" <%= stats.days === d ? 'selected' : '' %>>Last <%= d %> days</option><% }) %></select><button class="secondary">Apply</button><span class="muted small">Daily counts use UTC. Recorded visits, not diagnoses.</span></form>
<section class="stats" aria-label="Health summary"><% [['Student records',students,'All registered students'],['Health visits',stats.total,'In the selected period'],['Students seen',stats.affected,'Unique students with visits'],['Open in period',stats.open,'Unresolved visits started in selected dates']].forEach(([label,value,hint]) => { %><div class="card"><span class="muted"><%= label %></span><strong class="metric"><%= value %></strong><span class="muted small"><%= hint %></span></div><% }) %></section>
<div class="grid"><section class="card"><h2>How have students been feeling?</h2><p class="muted small">Visits recorded each day · last <%= stats.days %> days</p>
<% const max = Math.max(1, ...stats.trend.map(d => d.count)); const points = stats.trend.map((d,i) => `${(i/(stats.days-1)*700).toFixed(2)},${(165-d.count/max*145).toFixed(2)}`).join(' '); %>
<svg class="chart" viewBox="0 0 700 185" role="img" aria-label="Daily health visits, maximum <%= max %> visits per day. Exact counts are available below."><path d="M0 20H700 M0 92H700 M0 165H700" stroke="#dfe3e8" fill="none"/><polygon points="0,165 <%= points %> 700,165" fill="#e0eafb"/><polyline points="<%= points %>" fill="none" stroke="#0b57d0" stroke-width="3" stroke-linejoin="round"/><% stats.trend.forEach((d,i) => { %><circle cx="<%= i/(stats.days-1)*700 %>" cy="<%= 165-d.count/max*145 %>" r="3" fill="#0b57d0"><title><%= d.date %>: <%= d.count %> visits</title></circle><% }) %></svg><div class="chart-labels"><span><%= stats.trend[0].date %></span><span><%= stats.trend.at(-1).date %></span></div>
<% if (!stats.total) { %><p class="empty">No visits in this period. New visits will appear here automatically.</p><% } %><details class="chart-data"><summary>View daily counts</summary><div class="table-wrap"><table><thead><tr><th>Date (UTC)</th><th>Visits</th></tr></thead><tbody><% stats.trend.forEach(d => { %><tr><td><%= d.date %></td><td><%= d.count %></td></tr><% }) %></tbody></table></div></details></section>
<section class="card"><h2>Commonly recorded illnesses</h2><p class="muted small">A visit may include more than one illness.</p><% stats.illnesses.slice(0,6).forEach(s => { %><div class="bar-row"><div class="bar-label"><span><%= s.name %></span><strong><%= s.count %></strong></div><div class="bar-track"><div class="bar-fill" style="width:<%= s.count / Math.max(1, stats.total) * 100 %>%"></div></div></div><% }) %><% if (!stats.illnesses.length) { %><p class="empty">Illness trends will appear after a visit is recorded.</p><% } %></section></div>
<div class="grid"><section class="card"><div class="page-head"><h2>Recent visits</h2><a href="/student/complaints">All visits →</a></div><div class="table-wrap"><table><thead><tr><th>Student</th><th>Complaint</th><th>Severity</th><th>Status</th></tr></thead><tbody><% stats.recent.forEach(c => { %><tr><td><a href="/student/view/<%= c.studentId %>"><%= c.student.name %></a></td><td><%= c.complaintIdent %></td><td><span class="badge <%= c.severity %>"><%= c.severity %></span></td><td><%= c.ended ? 'Resolved' : 'Open' %></td></tr><% }) %></tbody></table><% if (!stats.total) { %><p class="empty">No recent visits.</p><% } %></div></section><div><section class="card"><h2><%= isAdmin ? 'Nurses on shift' : 'Your shift' %></h2><% activeShifts.forEach(s => { %><p><span class="badge active">On shift</span> <%= s.nurse.name %><br><span class="muted small">Started <%= s.startTime.toLocaleString() %></span></p><% }) %><% if (!activeShifts.length) { %><p class="muted">No open shifts.</p><% } %><p class="muted small">Open shifts reflect clock-in records, not live online status. Refresh for updates.</p><% if (isAdmin) { %><a href="/admin/shifts">Review shift log →</a><% } %></section><section class="card"><h2>Severity breakdown</h2><% Object.entries(stats.severity).forEach(([name,count]) => { %><div class="bar-label"><span><%= name %></span><strong><%= count %></strong></div><% }) %></section></div></div>
<%- include('partials/workspace-end') %>
