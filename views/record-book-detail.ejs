<%- include('partials/workspace-start', {title: book.name}) %><header class="page-head"><h1><%= book.name %></h1><a href="/admin/record-books">All record books</a></header><section class="card table-wrap"><table><thead><tr><% book.fields.forEach(f => { %><th><%= f.name %> <%= f.required ? '*' : '' %></th><% }) %></tr></thead><tbody><% book.rows.forEach(row => { %><tr><% book.fields.forEach(f => { %><td><%= row.values.find(v => v.columnId === f.id)?.value || '—' %></td><% }) %></tr><% }) %></tbody></table><% if (!book.rows.length) { %><p class="empty">No entries recorded in this book.</p><% } %></section><%- include('partials/workspace-end') %>
