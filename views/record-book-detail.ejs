<%- include('partials/workspace-start', {title: book.name}) %>
<header class="page-head record-detail-head"><div><div class="eyebrow">Record book</div><h1><%= book.name %></h1><p class="subtitle"><%= book.fields.length %> columns · <%= book.rows.length %> entries</p></div><a class="button secondary" href="/admin/record-books">← All record books</a></header>

<% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
<div class="record-book-tools">
  <section class="card record-tool-card"><h2>Add an entry</h2><p class="muted">Fill in the fields to add a new row to this book.</p>
    <% if (book.fields.length) { %>
    <form class="record-entry-form" method="post" action="/admin/record-books/<%= book.id %>/entries">
      <% book.fields.forEach(field => { %><label><%= field.name %><% if (field.required) { %> <span class="required-mark">Required</span><% } %>
        <% if (field.type === 'BOOLEAN') { %><select name="field_<%= field.id %>" <%= field.required ? 'required' : '' %>><option value="">Choose…</option><option value="true">Yes</option><option value="false">No</option></select>
        <% } else { %><input name="field_<%= field.id %>" type="<%= field.type === 'NUMBER' ? 'number' : field.type === 'DATE' ? 'date' : 'text' %>" <%= field.type === 'NUMBER' ? 'step="any"' : '' %> <%= field.required ? 'required' : '' %>><% } %>
      </label><% }) %>
      <button type="submit">Save entry</button>
    </form>
    <% } else { %><p class="empty">Add at least one column before recording entries.</p><% } %>
  </section>
  <section class="card record-tool-card"><h2>Add columns</h2><p class="muted">New columns will be available for entries. Existing entries will show a blank value for them.</p>
    <form id="add-fields-form" class="add-fields-form" method="post" action="/admin/record-books/<%= book.id %>/columns"><div id="new-columns" class="column-list"></div><div class="add-field-actions"><button class="secondary" id="add-field" type="button">＋ Add column</button><button type="submit">Save columns</button></div></form>
  </section>
</div>

<section class="card saved-entries"><div class="saved-entries-heading"><div><h2>Entries</h2><p class="muted">Most recent entries appear first.</p></div></div>
  <% if (book.rows.length && book.fields.length) { %><div class="table-wrap"><table><thead><tr><th>Recorded</th><% book.fields.forEach(field => { %><th><%= field.name %><% if (field.required) { %> <span class="required-mark">*</span><% } %></th><% }) %></tr></thead><tbody><% book.rows.forEach(row => { %><tr><td><time datetime="<%= row.createdAt.toISOString() %>"><%= row.createdAt.toLocaleString() %></time></td><% book.fields.forEach(field => { const saved = row.values.find(value => value.columnId === field.id); const displayValue = saved ? (field.type === 'BOOLEAN' ? (saved.value === 'true' ? 'Yes' : saved.value === 'false' ? 'No' : saved.value) : saved.value) : ''; %><td><%= displayValue || '—' %></td><% }) %></tr><% }) %></tbody></table></div>
  <% } else { %><p class="empty">No entries yet. Add an entry above to start this record book.</p><% } %>
</section>

<style>
.record-detail-head{margin-bottom:22px}.record-detail-head h1{margin-bottom:5px}.record-detail-head p{margin:0}.record-book-tools{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(320px,.8fr);gap:18px;align-items:start}.record-tool-card h2,.saved-entries h2{font-size:20px;margin:0 0 4px}.record-tool-card>p,.saved-entries-heading p{margin:0 0 18px}.record-entry-form{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:14px}.record-entry-form label{font-size:12px}.record-entry-form input,.record-entry-form select{margin-top:5px}.record-entry-form button{grid-column:1/-1;justify-self:start}.required-mark{font-size:10px;color:#7a5c0b;text-transform:uppercase;letter-spacing:.04em}.column-list{display:grid;gap:10px}.column-row{display:grid;grid-template-columns:minmax(120px,1fr) minmax(110px,.7fr) auto;gap:10px;align-items:end;padding:12px;background:#f7f8fa;border:1px solid var(--line);border-radius:12px}.column-row label{font-size:11px}.column-row input,.column-row select{margin-top:4px}.column-row .required-option{display:flex;align-items:center;gap:6px;padding-bottom:10px;white-space:nowrap}.column-row .required-option input{width:auto;margin:0}.column-row .remove-column{background:#fff;color:#8a3026;border:1px solid #e6c7c3;padding:7px 10px;font-size:12px}.add-field-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:12px}.saved-entries{margin-top:4px}.saved-entries-heading p{margin-bottom:14px}.saved-entries table{min-width:650px}.saved-entries th:first-child,.saved-entries td:first-child{padding-left:12px;white-space:nowrap}.saved-entries td{vertical-align:top}.saved-entries time{font-size:12px;color:var(--muted)}@media(max-width:850px){.record-book-tools{grid-template-columns:1fr}}@media(max-width:650px){.record-detail-head{gap:12px}.record-detail-head .button{align-self:flex-start}.column-row{grid-template-columns:1fr 1fr}.column-row .required-option{padding-bottom:9px}}
</style>
<script>
(() => {
  const container = document.getElementById('new-columns');
  let nextColumn = 0;
  function addColumn() {
    const index = nextColumn++;
    const row = document.createElement('div'); row.className = 'column-row';
    row.innerHTML = `<label>Column name<input name="columns[${index}][name]" maxlength="80" placeholder="e.g. Notes" required></label><label>Type<select name="columns[${index}][type]"><option value="STRING">Text</option><option value="NUMBER">Number</option><option value="DATE">Date</option><option value="BOOLEAN">Yes / no</option></select></label><label class="required-option"><input type="checkbox" name="columns[${index}][required]" value="true"> Required</label><button class="remove-column" type="button" aria-label="Remove column">Remove</button>`;
    row.querySelector('.remove-column').addEventListener('click', () => row.remove()); container.append(row); row.querySelector('input:not([type="checkbox"])').focus();
  }
  document.getElementById('add-field').addEventListener('click', addColumn);
  document.getElementById('add-fields-form').addEventListener('submit', event => {
    const names = [...container.querySelectorAll('input:not([type="checkbox"])')].map(input => input.value.trim().toLocaleLowerCase());
    if (!names.length) { event.preventDefault(); alert('Add at least one column.'); return; }
    if (new Set(names).size !== names.length) { event.preventDefault(); alert('Column names must be unique.'); }
  });
  addColumn();
})();
</script>
<%- include('partials/workspace-end') %>
