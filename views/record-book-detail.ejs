<%- include('partials/workspace-start', {title: book.name}) %>
<header class="page-head record-detail-head"><div><div class="eyebrow">Record book</div><h1><%= book.name %></h1><p class="subtitle"><%= book.fields.length %> columns · <%= book.rows.length %> entries</p></div><a class="button secondary" href="/admin/record-books">← All record books</a></header>

<% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
<section class="card spreadsheet" data-book-id="<%= book.id %>">
  <div class="grid-toolbar"><button id="save-grid" type="button">Save changes</button><button id="new-row" type="button" class="secondary">＋ Add a row</button><label>Find a record<input id="grid-search" type="search" placeholder="Type a name or word"></label></div>
  <p id="grid-status" role="status" aria-live="polite">Click a box to type. When you finish, press Save changes.</p>
  <div class="table-wrap" role="region" aria-label="Record sheet — scroll sideways for more columns" tabindex="0"><table id="record-grid"><caption class="visually-hidden"><%= book.name %> — editable record sheet</caption><thead><tr><th scope="col">Row</th><% book.fields.forEach(field => { %><th scope="col" data-column="<%= field.id %>" data-type="<%= field.type %>"><span class="column-heading"><%= field.name %></span><% if (field.required) { %><span class="required-mark"> (required)</span><% } %></th><% }) %><th scope="col" class="row-actions">Delete rows</th></tr></thead><tbody>
  <% book.rows.forEach((row, index) => { %><tr data-row="<%= row.id %>"><th scope="row"><%= index + 1 %></th><% book.fields.forEach(field => { const value = row.values.find(v => v.columnId === field.id)?.value || ''; %><td><% if(field.type === 'BOOLEAN') { %><select aria-label="<%= field.name %>, row <%= index + 1 %>"><option value=""></option><option value="true" <%= value === 'true' ? 'selected' : '' %>>Yes</option><option value="false" <%= value === 'false' ? 'selected' : '' %>>No</option></select><% } else { %><input aria-label="<%= field.name %>, row <%= index + 1 %>" type="<%= field.type === 'NUMBER' ? 'number' : field.type === 'DATE' ? 'date' : 'text' %>" step="any" value="<%= value %>"><% } %></td><% }) %><td class="row-actions"><button type="button" class="remove-grid-row secondary">Delete row</button></td></tr><% }) %>
  </tbody></table></div>
  <p id="grid-empty" class="muted" <%= book.rows.length ? 'hidden' : '' %>>No records yet. Press Add a row to begin.</p>
<details id="sheet-options" class="sheet-options">
  <summary>Sheet options</summary>
  <p>Use these options to change the book or its columns. Press Save changes afterwards.</p>
  <label>Book name<input id="book-name" maxlength="100" value="<%= book.name %>"></label>
  <button id="export-grid" type="button" class="secondary">Download spreadsheet (CSV)</button>
  <h2>Change columns</h2>
  <div class="column-list"><% book.fields.forEach(field => { %>
    <div class="column-setting" id="column-setting-<%= field.id %>">
      <label>Column name<input class="column-name" maxlength="80" value="<%= field.name %>"></label>
      <label class="required-option"><input type="checkbox" <%= field.required ? 'checked' : '' %>> Must be filled in</label>
      <button type="button" class="remove-grid-column secondary" data-column-id="<%= field.id %>">Delete column</button>
    </div>
  <% }) %></div>
  <p>To delete a row, use the Delete row button at the end of that row.</p>
</details>
</section>
<details id="add-column-options" class="record-book-tools sheet-options card">
  <summary>Add a new column</summary>

  <section class="card record-tool-card"><h2>Add columns</h2><p class="muted">New columns will be available for entries. Existing entries will show a blank value for them.</p>
    <form id="add-fields-form" class="add-fields-form" method="post" action="/admin/record-books/<%= book.id %>/columns"><div id="new-columns" class="column-list"></div><div class="add-field-actions"><button class="secondary" id="add-field" type="button">＋ Add column</button><button type="submit">Save columns</button></div></form>
  </section>
</details>

<script src="/js/record-grid.js" defer></script>
<style>
.record-detail-head{margin-bottom:24px}.record-detail-head p{margin:0}.spreadsheet{padding:20px;font-size:18px}.grid-toolbar{display:flex;gap:12px;align-items:center;flex-wrap:wrap}.grid-toolbar button{min-height:48px;font-size:18px;border-radius:6px}.grid-toolbar label{margin-left:auto;font-size:16px}.grid-toolbar input{margin:4px 0 0;max-width:300px}#grid-status{margin:18px 0;color:#38463f;font-size:18px}#grid-status.error{color:#923f2f}.table-wrap{max-height:65vh;border:1px solid #a9b8b0}#record-grid{border-collapse:separate;border-spacing:0;min-width:100%;width:max-content}#record-grid th,#record-grid td{padding:0;border:0;border-right:1px solid #bdc8c1;border-bottom:1px solid #bdc8c1;min-width:180px}#record-grid thead th{position:sticky;top:0;z-index:2;background:#e7efe9;color:#203b2b;padding:12px;text-transform:none;letter-spacing:0;font-size:18px;font-weight:650;text-align:left}#record-grid tr>:first-child{position:sticky;left:0;z-index:1;background:#eff3f0;min-width:48px;width:48px;text-align:center;padding:10px;color:#38463f;font-size:16px}#record-grid thead th:first-child{z-index:3}#record-grid td input,#record-grid td select{display:block;margin:0;min-width:180px;width:100%;min-height:48px;border:0;border-radius:0;padding:10px 12px;font-size:18px;background:transparent}#record-grid td:focus-within{background:#f0f7ee}#record-grid td input:focus,#record-grid td select:focus{outline:3px solid #18734c;outline-offset:-3px}#record-grid .row-actions{display:none}.sheet-options-open #record-grid .row-actions{display:table-cell;padding:6px}#record-grid button{white-space:nowrap;border-radius:6px;font-size:16px;min-height:44px}.required-mark{font-size:14px;font-weight:400}.sheet-options{margin-top:22px;font-size:18px}.sheet-options summary{cursor:pointer;font-size:18px;font-weight:600;padding:12px 0}.sheet-options label{font-size:16px}.sheet-options>label{max-width:420px;margin:16px 0}.sheet-options h2{margin-top:24px}.sheet-options button{font-size:16px;min-height:44px;border-radius:6px}.sheet-options p{margin:12px 0}.column-list{display:grid;gap:12px;margin:16px 0}.column-setting,.column-row{display:flex;gap:16px;align-items:center;flex-wrap:wrap;padding:16px;border:1px solid var(--line);background:#f7f9f7}.column-setting>label:first-child,.column-row>label:first-child{flex:1;min-width:160px}.required-option{display:flex;align-items:center;gap:8px}.required-option input{width:22px;height:22px;margin:0}.record-tool-card{border:0;padding:0;margin:12px 0}.add-field-actions{display:flex;gap:12px;flex-wrap:wrap}.visually-hidden{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}@media(max-width:650px){.spreadsheet{padding:12px}.grid-toolbar label{margin-left:0;width:100%}.grid-toolbar input{max-width:none}}
</style>
<script>
(() => {
  const container = document.getElementById('new-columns');
  let nextColumn = 0;
  function addColumn() {
    const index = nextColumn++;
    const row = document.createElement('div'); row.className = 'column-row';
    row.innerHTML = `<label>Column name<input name="columns[${index}][name]" maxlength="80" placeholder="e.g. Notes" required></label><label>Type<select name="columns[${index}][type]"><option value="STRING">Text</option><option value="NUMBER">Number</option><option value="DATE">Date</option><option value="BOOLEAN">Yes / no</option></select></label><label class="required-option"><input type="checkbox" name="columns[${index}][required]" value="true"> Required</label><button class="remove-column" type="button" aria-label="Remove column">Remove</button>`;
    row.querySelector('.remove-column').addEventListener('click', () => row.remove()); container.append(row); row.querySelector('input:not([type="checkbox"])').focus();
  }
  document.getElementById('add-column-options').addEventListener('toggle', event => {
    if (event.target.open && !container.children.length) addColumn();
  });
  document.getElementById('add-field').addEventListener('click', addColumn);
  document.getElementById('add-fields-form').addEventListener('submit', event => {
    const names = [...container.querySelectorAll('input:not([type="checkbox"])')].map(input => input.value.trim().toLocaleLowerCase());
    if (!names.length) { event.preventDefault(); alert('Add at least one column.'); return; }
    if (new Set(names).size !== names.length) { event.preventDefault(); alert('Column names must be unique.'); }
  });
})();
</script>
<%- include('partials/workspace-end') %>
