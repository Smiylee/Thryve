<%- include('partials/workspace-start', {title: 'Health visits'}) %><header class="page-head"><div><h1>Health visits</h1><p class="subtitle">Recorded visits, newest first.</p></div><a class="button" href="/student/records">Open student records</a></header><section class="card table-wrap"><table><thead><tr><th>Date</th><th>Student</th><th>Complaint</th><th>Severity</th><th>Status</th></tr></thead><tbody><% complaints.forEach(c => { %><tr><td><%= c.started.toLocaleDateString() %></td><td><a href="/student/view/<%= c.studentId %>#visit-<%= c.id %>"><%= c.student.name %></a></td><td><%= c.complaintIdent %></td><td><span class="badge <%= c.severity %>"><%= c.severity %></span></td><td><%= c.ended ? 'Resolved' : 'Open' %></td></tr><% }) %></tbody></table><% if (!complaints.length) { %><p class="empty">No visits yet. Open a student record to add one.</p><% } %></section><%- include('partials/workspace-end') %>
