<%- include('partials/workspace-start', {title: editing ? 'Edit student' : 'Add student'}) %><header class="page-head"><div><h1><%= editing ? 'Update student record' : 'Add student' %></h1><p class="subtitle">Enter the student details.</p></div><a href="/student/records">Back to records</a></header><% if(error) { %><p role="alert" class="error"><%= error %></p><% } %><form class="card form-grid" method="post" action="<%= editing ? '/student/edit/'+student.id : '/add/student' %>"><label>Full name<input name="name" value="<%= student.name || '' %>" required maxlength="160"></label><label>Class<input name="class" value="<%= student.class || '' %>" required placeholder="e.g. JSS 1"></label><label>Age<input name="age" type="number" min="1" max="100" value="<%= student.age || '' %>" required></label><label>Height (cm, optional)<input name="height" type="number" step="any" min="0.1" value="<%= student.height ?? '' %>"></label><label>Weight (kg, optional)<input name="weight" type="number" step="any" min="0.1" value="<%= student.weight ?? '' %>"></label><% for(const [key,label] of [['lastTetanus','Last tetanus treatment'],['lastAntiMalaria','Last anti-malaria treatment']]) { const date = student[key] ? new Date(student[key]) : null; %><label><%= label %> (optional)<input name="<%= key %>" type="date" max="<%= new Date().toISOString().slice(0,10) %>" value="<%= date && !isNaN(date) ? date.toISOString().slice(0,10) : '' %>"></label><% } %><div class="wide"><button>Save student record</button></div></form><%- include('partials/workspace-end') %>
