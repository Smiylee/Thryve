<%- include('partials/workspace-start', {title: 'Care team'}) %><header class="page-head"><div><h1>Nurses</h1><p class="subtitle">Nurses assigned to your school.</p></div><a class="button" href="/admin/add/nurse">+ Add nurse</a></header><section class="card table-wrap"><table><thead><tr><th>Name</th><th>Email</th><th>Phone</th></tr></thead><tbody><% nurses.forEach(n=> { %><tr><td><%= n.name %></td><td><%= n.email %></td><td><%= n.phone || 'Not recorded' %></td></tr><% }) %></tbody></table><% if (!nurses.length) { %><p class="empty">Add a nurse to start building your care team.</p><% } %></section><%- include('partials/workspace-end') %>
