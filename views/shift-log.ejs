<%- include('partials/workspace-start', {title: 'Shift log'}) %><div class="eyebrow">Attendance</div><header class="page-head"><div><h1>Shift log</h1><p class="subtitle">Review nurse clock-in and clock-out records.</p></div><a class="button secondary" href="<%= isAdmin ? '/admin/shifts' : '/nurse/shifts' %>">Refresh log</a></header><% if (!isAdmin) { %><section class="card shift-control"><div><h2><%= activeShift ? 'You are on shift' : 'You are off shift' %></h2><p class="muted">Clock out when your work ends. You can stay signed in to review records.</p></div><form method="post" action="/nurse/shifts/<%= activeShift ? 'clock-out' : 'clock-in' %>"><button><%= activeShift ? 'Clock out' : 'Clock in' %></button></form></section><% } %><section class="stats"><% [['Shifts shown', shifts.length],['Active',shifts.filter(s=>!s.endTime).length],['Awaiting review',shifts.filter(s=>s.endTime&&!s.validatedAt).length],['Completed hours',(shifts.reduce((n,s)=>n+(s.endTime ? s.endTime-s.startTime : 0),0)/3600000).toFixed(1)]].forEach(([label,value])=>{ %><div class="card"><span class="muted"><%= label %></span><strong class="metric"><%= value %></strong></div><% }) %></section><div class="actions"><% ['all','active','pending','validated'].forEach(s => { %><a class="button <%= status === s ? '' : 'secondary' %>" href="?status=<%= s %>"><%= s[0].toUpperCase()+s.slice(1) %></a><% }) %></div><p class="muted small">Closing a browser does not clock out. Close forgotten shifts here before validating them. Times are shown in server local time.</p><section class="card table-wrap"><table><thead><tr><th>Nurse</th><th>Clocked in</th><th>Clocked out</th><th>Duration</th><th>Status</th><th>Review</th></tr></thead><tbody><% shifts.forEach(s => { const minutes = Math.max(0,Math.floor(((s.endTime || new Date())-s.startTime)/60000)); const state = !s.endTime ? 'active' : s.validatedAt ? 'validated' : 'pending'; %><tr><td><strong><%= s.nurse.name %></strong><br><span class="muted small"><%= s.nurse.email %></span></td><td><%= s.startTime.toLocaleString() %></td><td><%= s.endTime?.toLocaleString() || 'Still on shift' %></td><td><%= Math.floor(minutes/60) %>h <%= minutes%60 %>m</td><td><span class="badge <%= state %>"><%= state %></span></td><td><% if (isAdmin && !s.validatedAt) { %><form method="post" action="/admin/shifts/<%= s.id %>/<%= s.endTime ? 'validate' : 'close' %>"><button class="secondary small"><%= s.endTime ? 'Validate shift' : 'End shift now' %></button></form><% } else if(s.validatedAt) { %><span class="muted small">Validated <%= s.validatedAt.toLocaleString() %><br>Matron #<%= s.validatedBy %></span><% } %></td></tr><% }) %></tbody></table><% if (!shifts.length) { %><p class="empty">No <%= status === 'all' ? '' : status %> shifts yet. Nurse logins will appear here.</p><% } %></section><%- include('partials/workspace-end') %>
