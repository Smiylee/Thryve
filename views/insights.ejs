<%- include('partials/workspace-start', {title: 'Health analytics'}) %>
<div class="eyebrow">Analytics</div><header class="page-head"><div><h1>Analytics</h1><p class="subtitle">Visits, illnesses, and open cases.</p></div><button class="secondary" onclick="window.print()">Print report</button></header>
<form class="actions" method="get"><label for="days">Reporting period</label><select class="filter" id="days" name="days"><% [7,30,90].forEach(d=>{ %><option value="<%= d %>" <%= stats.days===d?'selected':'' %>>Last <%= d %> days</option><% }) %></select><button>Update report</button></form>
<section class="stats"><% [['Recorded visits',stats.total],['Students seen',stats.affected],['Resolved visits',stats.total-stats.open],['Resolution rate',stats.total ? Math.round((stats.total-stats.open)/stats.total*100)+'%' : '—']].forEach(([label,value])=>{ %><div class="card"><span class="muted"><%= label %></span><strong class="metric"><%= value %></strong></div><% }) %></section>
<section class="card"><h2>Daily visit trend</h2><p class="muted small"><%= stats.trend[0].date %> to <%= stats.trend.at(-1).date %> · UTC</p><div class="daily-chart"><% const maximum=Math.max(1,...stats.trend.map(d=>d.count)); stats.trend.forEach(d=>{ %><div class="daily-column" title="<%= d.date %>: <%= d.count %> visits"><div style="height:<%= Math.max(2,d.count/maximum*150) %>px"><span><%= d.count %></span></div><small><%= d.date.slice(5) %></small></div><% }) %></div><% if(!stats.total){ %><p class="empty">No visits recorded in this period. Saved health visits will populate this report.</p><% } %><details><summary>Daily counts</summary><table><thead><tr><th>Date</th><th>Visits</th></tr></thead><tbody><% stats.trend.forEach(d=>{ %><tr><td><%= d.date %></td><td><%= d.count %></td></tr><% }) %></tbody></table></details></section>
<div class="grid"><section class="card"><h2>Recorded illnesses</h2><p class="muted small">Visits may have multiple illness tags; percentages may total more than 100%.</p><% stats.illnesses.forEach(s=>{ %><div class="bar-row"><div class="bar-label"><span><%= s.name %></span><strong><%= s.count %> · <%= Math.round(s.count/Math.max(1,stats.total)*100) %>%</strong></div><div class="bar-track"><div class="bar-fill" style="width:<%= s.count/Math.max(1,stats.total)*100 %>%"></div></div></div><% }) %><% if(!stats.illnesses.length){ %><p class="empty">No illnesses recorded.</p><% } %></section><section class="card"><h2>Severity distribution</h2><% Object.entries(stats.severity).forEach(([name,count])=>{ %><div class="bar-row"><div class="bar-label"><span class="badge <%= name %>"><%= name %></span><strong><%= count %></strong></div><div class="bar-track"><div class="bar-fill" style="width:<%= count/Math.max(1,stats.total)*100 %>%"></div></div></div><% }) %></section></div>
<section class="card table-wrap"><h2>Visits by class</h2><table><thead><tr><th>Class</th><th>Visits</th><th>Open cases</th><th>Resolved</th><th>Records</th></tr></thead><tbody><% classes.forEach(([name,data])=>{ %><tr><td><%= name %></td><td><%= data.visits %></td><td><%= data.open %></td><td><%= data.visits-data.open %></td><td><a href="/student/records?q=<%= encodeURIComponent(name) %>">View students →</a></td></tr><% }) %></tbody></table><% if(!classes.length){ %><p class="empty">Class comparisons appear when students have recorded visits.</p><% } %></section><p class="muted small">This report summarizes recorded complaints, not confirmed diagnoses or population disease rates. Resolution reflects current case status for visits started within this period.</p>
<%- include('partials/workspace-end') %>
