<%- include('partials/workspace-start', {title: 'Student records'}) %><div class="eyebrow">Student records</div><header class="page-head"><div><h1>Student records</h1><p class="subtitle">View and update student information and visit history.</p></div><a class="button" href="/add/student">+ Add student</a></header><form class="search" method="get"><label class="muted" for="q">Search</label><input id="q" name="q" value="<%= q %>" placeholder="Student name or class"><button class="secondary">Search</button><% if(q) { %><a href="/student/records">Clear</a><% } %></form><p class="muted small"><%= students.length %> student<%= students.length === 1 ? "" : "s" %><%= q ? " matching your search" : " in the registry" %></p><section class="card table-wrap"><table><thead><tr><th>Student</th><th>Class</th><th>Age</th><th>Health visits</th><th>Record</th></tr></thead><tbody><% students.forEach(s => { %><tr><td><strong><%= s.name %></strong></td><td><%= s.class %></td><td><%= s.age %></td><td><%= s._count.complaints %></td><td><a href="/student/view/<%= s.id %>">Open record →</a></td></tr><% }) %></tbody></table><% if (!students.length) { %><p class="empty"><%= q ? 'No students match your search.' : 'No student records yet. Add a student to get started.' %></p><% } %></section><%- include('partials/workspace-end') %>
