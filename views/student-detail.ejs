<%- include('partials/workspace-start', {title: student.name}) %><div class="eyebrow">Student record · #<%= student.id %></div><header class="page-head"><div><h1><%= student.name %></h1><p class="subtitle"><%= student.class %> · <%= student.age %> years old</p></div><div class="actions"><a class="button secondary" href="/student/edit/<%= student.id %>">Edit profile</a><a href="/student/records">All students</a></div></header><section class="card"><h2>Health profile</h2><dl class="details"><% [['Height',student.height ? student.height+' cm' : 'Not recorded'],['Weight',student.weight ? student.weight+' kg' : 'Not recorded'],['Last tetanus',student.lastTetanus?.toLocaleDateString() || 'Not recorded'],['Last anti-malaria',student.lastAntiMalaria?.toLocaleDateString() || 'Not recorded']].forEach(([label,value])=> { %><div><dt><%= label %></dt><dd><%= value %></dd></div><% }) %></dl></section><div class="grid"><section><h2>History of care <span class="badge"><%= student.complaints.length %> visits</span></h2><% if (!student.complaints.length) { %><div class="card empty">No health visits recorded for this student yet.</div><% } %><% student.complaints.forEach(c=> { %><article class="card visit" id="visit-<%= c.id %>"><div class="page-head"><h2><%= c.complaintIdent %></h2><span class="badge <%= c.severity %>"><%= c.severity %> · <%= c.ended ? 'resolved' : 'open' %></span></div><p class="muted small"><%= c.started.toLocaleString() %> · Recorded by <%= c.nurse.name %></p><p><% c.sicknesses.forEach(s => { %><span class="badge"><%= s.name %></span> <% }) %></p><p class="note"><%= c.complaintNotes %></p><p><strong>Medication:</strong> <%= c.medication || 'None' %></p><p class="muted small">Reported frequency: <%= c.frequency %> per day · Duration: <%= c.duration %> days</p><% if (c.ended) { %><p class="muted small">Resolved <%= c.ended.toLocaleString() %></p><% } else if (!isAdmin) { %><form method="post" action="/student/complaint/<%= c.id %>/resolve"><button class="secondary">Mark resolved</button></form><% } %></article><% }) %></section><% if (!isAdmin) { %><section class="card"><h2>Record a health visit</h2><form class="form-grid" method="post" action="/student/add/complaint/<%= student.id %>"><label class="wide">Main complaint<input name="complaintIdent" required maxlength="200"></label><label class="wide">Sicknesses (comma-separated)<input name="tags" placeholder="e.g. headache, fever"></label><label class="wide">Care notes<textarea name="complaintNotes" required></textarea></label><label class="wide">Medication given<textarea name="medication"></textarea></label><label>Frequency per day<input name="frequency" type="number" min="1" value="1" required></label><label>Duration in days<input name="duration" type="number" min="0" value="0" required></label><label class="wide">Severity<select name="severity"><option value="mild">Mild</option><option value="normal">Normal</option><option value="severe">Severe</option></select></label><div class="wide"><button>Save health visit</button></div></form></section><% } else { %><section class="card"><h2>Care team notes</h2><p class="muted">Nurses record visits during their shifts. Those visits feed directly into the health overview.</p></section><% } %></div><%- include('partials/workspace-end') %>
