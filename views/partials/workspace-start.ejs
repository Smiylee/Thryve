<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> · Thryve</title><link rel="stylesheet" href="/workspace.css"></head><body><div class="workspace"><nav class="sidebar" aria-label="Main navigation"><a class="brand" href="/dashboard">thryve<span>.</span></a><div class="eyebrow">School health workspace</div>
<% const links = [['/dashboard','Overview'],['/student/records','Student records'],['/student/complaints','Health visits'], ...(isAdmin ? [['/admin/shifts','Shift log'],['/admin/analytics','Analytics'],['/admin/nurses','Nurses'],['/admin/record-books','Record books']] : [['/nurse/shifts','My shifts'],['/nurse/analytics','Analytics']])]; links.forEach(([url,label]) => { const active = currentPath === url || (url === '/dashboard' && currentPath.endsWith('/dashboard')); %><a href="<%= url %>" class="<%= active ? 'active' : '' %>" <%- active ? 'aria-current="page"' : '' %>><%= label %></a><% }) %>
<footer><p><%= viewer %><br><%= isAdmin ? 'Matron workspace' : 'Nurse workspace' %></p><form action="/auth/logout" method="post"><button class="secondary"><%= isAdmin ? 'Sign out' : 'Clock out & sign out' %></button></form></footer></nav><main class="main">
